# Считывание данных
# df_src <- read_xlsx("C:/Users/GudievZK/Nextcloud/Data analysis/DA-68/data_request&src_data/2026.04.13_df_src.xlsx", sheet = "Исх.")
df_src <- read_xlsx("/Users/zelimkhan/Desktop/2026.04.13_df_src.xlsx", sheet = "Исх.")
# Очистка и приведение столбцов к единому формату
df_src <- clean_names(df_src)
glimpse(df_src)
df <- df_src %>%
mutate(my_questions = "Проверить признак офсетной закупки")
df <- df %>%
mutate(
across(
c(id_lota_eaist, reestrovyj_nomer_lota_eaist, nomer_sovmestnoj_zakupki,
reestrovyj_nomer_procedury_eaist, ikz, reestrovyj_nomer_procedury_na_eis,
entity_id_kpgz_iz_specifikacii_lota, entity_id_tz),
as.character
),
across(
c(kompleks, grbs, zakon_osnovanie, sposob_opredelenia_postavsika,
status_lota, priznak_kzc, priznak_kontrakta_so_vstrecnymi_o,
priznak_kontrakta_so_vstrecnymi_o_1, status_procedury, priznak_standartizacii_da_net,
konecnaa_kpgz_da_net, pozicia_kpgz_udalena_da_net, inf_ia_o_svazannyh_poziciah),
as.factor)
) %>%
select(id_lota_eaist, reestrovyj_nomer_lota_eaist, reestrovyj_nomer_procedury_eaist, reestrovyj_nomer_procedury_na_eis, ikz,
naimenovanie_predmeta_zakupki, zakon_osnovanie, sposob_opredelenia_postavsika,
nomer_sovmestnoj_zakupki, naimenovanie_ttz_stz,
entity_id_kpgz_iz_specifikacii_lota, kod_kpgz_iz_specifikacii_lota, naimenovanie_kpgz_iz_specifikaci,
summa_lota_po_pozicii_kpgz_rub, nmc_summa_po_vsej_procedure,
priznak_kzc, priznak_kontrakta_so_vstrecnymi_o, priznak_kontrakta_so_vstrecnymi_o_1,
kol_vo_podannyh_zaavok, status_lota, status_procedury,
kompleks, grbs, zakazcik,
priznak_standartizacii_da_net, konecnaa_kpgz_da_net, pozicia_kpgz_udalena_da_net,
data_udalenia_kpgz, data_standartizacii_pozicii, data_sozdania_pozicii_kpgz,
kolicestvo_podcinennyh_pozicij_kp, kolicestvo_standartizirovannyh_p, inf_ia_o_svazannyh_poziciah, entity_id_tz,
data_publikacii_procedury_na_eis, planiruemaa_data_publikacii_izves, planiruemaa_data_zaklucenia_kontr, my_questions)
glimpse(df)
skim_without_charts(df)
df <- df %>%
mutate(my_questions = if_else(
is.na(reestrovyj_nomer_procedury_na_eis),
paste(my_questions, "Почему в исх. данных содержится закупка с отсутствующим реестровым номером процедуры в ЕИС", sep = "; "), my_questions
))
df %>%
filter(is.na(reestrovyj_nomer_procedury_na_eis)) %>%
select(id_lota_eaist, reestrovyj_nomer_procedury_na_eis, kol_vo_podannyh_zaavok)
df <- df %>% filter(!is.na(kol_vo_podannyh_zaavok) | kol_vo_podannyh_zaavok != 0)
skim_without_charts(df)
df %>%
select(
id_lota_eaist, reestrovyj_nomer_lota_eaist, reestrovyj_nomer_procedury_eaist,
reestrovyj_nomer_procedury_na_eis, ikz, naimenovanie_predmeta_zakupki,
zakon_osnovanie, sposob_opredelenia_postavsika, nomer_sovmestnoj_zakupki,
naimenovanie_ttz_stz) %>%
filter(reestrovyj_nomer_procedury_na_eis == "373200068625000384") %>%
mutate(total_filtered_rows = n()) %>%
group_by(id_lota_eaist, reestrovyj_nomer_procedury_eaist) %>%
summarise(
group_n = n(),
rows_n = first(total_filtered_rows),
.groups = 'drop'
) %>%
mutate(reestrovyj_nomer_procedury_eis = "373200068625000384") %>%
arrange(desc(group_n))
df <- df %>%
mutate(my_questions = if_else(
sposob_opredelenia_postavsika == "закупка у единственного поставщика",
paste(my_questions, "Почему закупки у единственного поставщика имеют опубликованные извещения" , sep = "; "), my_questions
)
)
# susp <- df %>% filter(sposob_opredelenia_postavsika == "закупка у единственного поставщика")
#
# susp %>% group_by(priznak_standartizacii_da_net) %>%
#   summarise(
#     uniq_procedures = n_distinct(reestrovyj_nomer_procedury_na_eis),
#     sum = sum(summa_lota_po_pozicii_kpgz_rub)
#   )
metrics <- df %>%
group_by(zakon_osnovanie, priznak_standartizacii_da_net) %>%
summarise(
dkp_n_uniq_procedures = n_distinct(reestrovyj_nomer_procedury_eaist),
dkp_sum_of_specifications = sum(summa_lota_po_pozicii_kpgz_rub),
dkp_sum_of_nmck_d = sum(tapply(nmc_summa_po_vsej_procedure,
reestrovyj_nomer_procedury_eaist,
function(x) first(na.omit(x))))
) %>%
ungroup() # %>% adorn_totals(where = "row", name = "TOTAL") %>% as.tibble()
metrics
metrics
metrics <- metrics %>%
mutate(
ac_n_uniq_contract = c(135766, (174135-135766), 461836, (566230 - 461836)),
ac_sum_contract = c(789719941540, (2694424078030 - 789719941540), 1666246056730, (1976206922550 - 1666246056730)),
diff_procedures_n = ac_n_uniq_contract - dkp_n_uniq_procedures,
diff_sums_rub = ac_sum_contract - dkp_sum_of_nmck_d,
perc_diff_procedures = round((dkp_n_uniq_procedures - ac_n_uniq_contract)/ac_n_uniq_contract , 2),
perc_diff_sums = round((dkp_sum_of_nmck_d - ac_sum_contract)/ac_sum_contract, 2),
) %>%
select(zakon_osnovanie, priznak_standartizacii_da_net,
dkp_n_uniq_procedures, ac_n_uniq_contract, diff_procedures_n, perc_diff_procedures,
dkp_sum_of_nmck_d, ac_sum_contract, diff_sums_rub, perc_diff_sums)
metrics <- metrics %>%
group_by(zakon_osnovanie) %>%
mutate(
total_dkp_n_procedures = sum(dkp_n_uniq_procedures),
share_dkp_n_procedures = round(dkp_n_uniq_procedures/total_dkp_n_procedures, 2),
total_ac_n_uniq_contract = sum(ac_n_uniq_contract),
share_ac_n_uniq_contract = round(ac_n_uniq_contract/total_ac_n_uniq_contract, 2),
total_dkp_sum_of_nmck_d = sum(dkp_sum_of_nmck_d),
share_dkp_sum_of_nmck_d = round(dkp_sum_of_nmck_d/total_dkp_sum_of_nmck_d, 2),
total_ac_sum_contract = sum(ac_sum_contract),
share_ac_sum_contract = round(ac_sum_contract/total_ac_sum_contract, 2)
)
metrics
# Создаем справочник значений АЦ, чтобы не зависеть от порядка строк в таблице
ac_metrics <- tibble::tribble(
~zakon_osnovanie, ~priznak_standartizacii_da_net, ~ac_n_uniq_contract, ~ac_sum_contract,
"223-ФЗ",         "да",                           135766,             789719941540,
"223-ФЗ",         "нет",                          38369,              1904704136490,
"44-ФЗ",          "да",                           461836,             1666246056730,
"44-ФЗ",          "нет",                          104394,             309960865820
)
ac_metrics
# Рассчитываем показатели ДКП по закону-основанию и признаку стандартизации
dkp_metrics <- df %>%
group_by(zakon_osnovanie, priznak_standartizacii_da_net) %>%
summarise(
dkp_n_uniq_procedures = n_distinct(reestrovyj_nomer_procedury_eaist),
dkp_sum_of_nmck_d = sum(
tapply(
nmc_summa_po_vsej_procedure,
reestrovyj_nomer_procedury_eaist,
function(x) first(na.omit(x))
),
na.rm = TRUE
),
.groups = "drop"
)
dkp_metrics
# Объединяем показатели ДКП и АЦ
metrics <- dkp_metrics %>%
left_join(
ac_metrics,
by = c("zakon_osnovanie", "priznak_standartizacii_da_net")
) %>%
mutate(
diff_n_uniq = dkp_n_uniq_procedures - ac_n_uniq_contract,
diff_n_uniq_pct = diff_n_uniq / ac_n_uniq_contract,
diff_sum = dkp_sum_of_nmck_d - ac_sum_contract,
diff_sum_pct = diff_sum / ac_sum_contract
) %>%
group_by(zakon_osnovanie) %>%
mutate(
share_dkp_n_uniq_procedures = dkp_n_uniq_procedures / sum(dkp_n_uniq_procedures, na.rm = TRUE),
share_ac_n_uniq_contract = ac_n_uniq_contract / sum(ac_n_uniq_contract, na.rm = TRUE),
share_dkp_sum_of_nmck_d = dkp_sum_of_nmck_d / sum(dkp_sum_of_nmck_d, na.rm = TRUE),
share_ac_sum_contract = ac_sum_contract / sum(ac_sum_contract, na.rm = TRUE)
) %>%
ungroup()
metrics
View(metrics)
# Переводим абсолютные показатели в длинный формат для построения графиков
metrics_long_values <- metrics %>%
select(
zakon_osnovanie,
priznak_standartizacii_da_net,
dkp_n_uniq_procedures,
ac_n_uniq_contract,
dkp_sum_of_nmck_d,
ac_sum_contract
) %>%
pivot_longer(
cols = c(
dkp_n_uniq_procedures,
ac_n_uniq_contract,
dkp_sum_of_nmck_d,
ac_sum_contract
),
names_to = "metric",
values_to = "value"
) %>%
mutate(
source = case_when(
str_starts(metric, "dkp") ~ "ДКП",
str_starts(metric, "ac") ~ "АЦ"
),
metric_type = case_when(
metric %in% c("dkp_n_uniq_procedures", "ac_n_uniq_contract") ~ "Количество процедур / контрактов",
metric %in% c("dkp_sum_of_nmck_d", "ac_sum_contract") ~ "Сумма НМЦК(Д) / контрактов"
)
)
View(metrics_long_values)
ggplot(
data = metrics_long_values %>% filter(metric_type == "Количество процедур / контрактов"),
aes(
x = priznak_standartizacii_da_net,
y = value,
fill = source
)
) +
geom_col(position = "dodge") +
facet_wrap(~ zakon_osnovanie) +
scale_y_continuous(labels = scales::label_number(big.mark = " ")) +
labs(
title = "Сравнение количества процедур ДКП и контрактов АЦ",
x = "Признак стандартизации",
y = "Количество",
fill = "Методика"
) +
theme_minimal()
ggplot(
data = metrics_long_values %>% filter(metric_type == "Сумма НМЦК(Д) / контрактов"),
aes(
x = priznak_standartizacii_da_net,
y = value / 1000000000,
fill = source
)
) +
geom_col(position = "dodge") +
facet_wrap(~ zakon_osnovanie) +
labs(
title = "Сравнение сумм по методике ДКП и АЦ",
x = "Признак стандартизации",
y = "Сумма, млрд руб.",
fill = "Методика"
) +
theme_minimal()
ggplot(
data = metrics_long_shares,
aes(
x = source,
y = share,
fill = priznak_standartizacii_da_net
)
) +
geom_col(position = "stack") +
facet_grid(metric_type ~ zakon_osnovanie) +
scale_y_continuous(labels = scales::label_percent(accuracy = 1)) +
labs(
title = "Доля показателей внутри закона-основания",
x = "Методика",
y = "Доля внутри закона-основания",
fill = "Признак стандартизации"
) +
theme_minimal()
ggplot(
data = metrics_long_shares,
aes(
x = source,
y = share,
fill = priznak_standartizacii_da_net
)
) +
geom_col(position = "stack") +
facet_grid(metric_type ~ zakon_osnovanie) +
scale_y_continuous(labels = scales::label_percent(accuracy = 1)) +
labs(
title = "Доля показателей внутри закона-основания",
x = "Методика",
y = "Доля внутри закона-основания",
fill = "Признак стандартизации"
) +
theme_minimal()
# Переводим доли в длинный формат
metrics_long_shares <- metrics %>%
select(
zakon_osnovanie,
priznak_standartizacii_da_net,
share_dkp_n_uniq_procedures,
share_ac_n_uniq_contract,
share_dkp_sum_of_nmck_d,
share_ac_sum_contract
) %>%
pivot_longer(
cols = starts_with("share"),
names_to = "metric",
values_to = "share"
) %>%
mutate(
source = case_when(
str_detect(metric, "dkp") ~ "ДКП",
str_detect(metric, "ac") ~ "АЦ"
),
metric_type = case_when(
str_detect(metric, "n_uniq|contract") ~ "Доля по количеству",
str_detect(metric, "sum") ~ "Доля по сумме"
)
)
ggplot(
data = metrics_long_shares,
aes(
x = source,
y = share,
fill = priznak_standartizacii_da_net
)
) +
geom_col(position = "stack") +
facet_grid(metric_type ~ zakon_osnovanie) +
scale_y_continuous(labels = scales::label_percent(accuracy = 1)) +
labs(
title = "Доля показателей внутри закона-основания",
x = "Методика",
y = "Доля внутри закона-основания",
fill = "Признак стандартизации"
) +
theme_minimal()
metrics
