descriptions_stat <- aggregate(cbind(hp, disp) ~ am, df, sd) #v1
df <- mtcars
str(df)
# Изменяем ти переменных с numeric на factor
df$vs  <- factor(df$vs, labels = c("V", "S"))
df$am  <- factor(df$am, labels = c("Auto", "Manual"))
# Расчитываем описательные статистики
median(df$mpg)
mean(df$disp)
sd(df$hp)
range(df$cyl)
# Результаты расчетов сохраняем в переменные (чтобы каждый раз не пересчитывать)
mean_disp <- mean(df$disp)
# Можно расчитывть описательные статистики только для переменных, которые отвечают определенным условиям
mean(df$mpg[df$cyl == 6])
mean(df$mpg[df$cyl == 6 & df$vs == 'V'])
sd(df$hp[df$cyl !=3 & df$am == 'Auto'])
result <- mean(df$qsec[df$cyl != 3 & df$mpg > 20])
mean_hp_vs <- aggregate(x = df$hp, by = list(df$vs), FUN = mean)
mean_hp_vs
colnames(mean_hp_vs) <- c('VS', 'Mean HP')
mean_hp_vs
aggregate(hp ~ vs, df, mean)
aggregate(hp ~ vs+am, df, mean)
aggregate(. ~ vs+am, df, mean)
View(df)
#### Шаг 3 из 15. Выберем данные для анализа mtcars. ####
?mtcars # Данный дата фрейм хорош тем, что в нем есть различные типы переменных
str(df) # посмотрим структуру данных.Помимо количества наблюдений (строк) и переменных (столбцов) показывает еще тип
df$mpg
df$mpg[1,2]
df$mpg[1]
df$mpg[c(1, 2)]
df$mpg[c(1, 2, 3)]
df$mpg[c(1:3)]
colnames(mean_hp_vs)
colnames(df)
# В вышеуказаннух примерах мы использовали тоько одну количественную переменную для расчета ОС,
# но можно расчитать сразу для нескольких переменных с учетом разделения их на группы
aggregate(x = df[, -c(8, 9)], by = list(df$am), FUN = median)  # расчет ОС для всех переменных кроме 8 и 9 колонки
aggregate(. ~ vs+am, df, mean) # . - расчитываем для всех строк
cbind(df$mpg, df$disp)
aggregate(. ~ vs+am, df, mean) # . - расчитываем для всех строк
